[Unit]
Description=EdgeRun PXE UDP 4011 boot-server helper
After=network-online.target edgerun-netboot.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/home/ken/edgerun-c/edgerun-metal/build/edgerun-pxe4011
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
