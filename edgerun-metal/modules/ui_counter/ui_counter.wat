(module
  (type $ui_emit_t (func (param i64 i64) (result i64)))
  (type $region_base_t (func (param i64) (result i64)))
  (type $main_t (func (result i64)))
  (import "edgerun.ui" "emit" (func $ui_emit (type $ui_emit_t)))
  (import "edgerun.memory" "region_base" (func $region_base (type $region_base_t)))
  (memory 1)

  ;; Purpose: prove authored WASM apps can emit bounded UI scene records.
  ;; Intention: keep UI authority in the host admission contract, not in the app.
  (func (export "main") (type $main_t) (result i64)
    (local $inbox i32)
    (local $outbox64 i64)
    (local $outbox i32)
    (local $sequence i32)

    (i64.const 1)
    (call $region_base)
    (i32.wrap_i64)
    (local.set $inbox)

    (i64.const 2)
    (call $region_base)
    (local.tee $outbox64)
    (i32.wrap_i64)
    (local.set $outbox)

    (local.get $inbox)
    (i32.load offset=20)
    (local.set $sequence)

    (local.get $outbox)
    (i32.const 1)
    (i32.store16 offset=0)

    (local.get $outbox)
    (i32.const 3)
    (i32.store offset=4)

    (local.get $outbox)
    (i32.const 1)
    (i32.store offset=8)

    (local.get $outbox)
    (i32.const 1)
    (i32.store offset=12)

    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=16)

    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=20)

    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=24)

    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=28)

    (local.get $outbox)
    (i32.const 1)
    (i32.store offset=32)

    ;; rect record at outbox + 36: x, y, w, h, radius, color, color2, mode, shadow.
    (local.get $outbox)
    (i32.const 1107296256)
    (i32.store offset=36)
    (local.get $outbox)
    (i32.const 1111490560)
    (i32.store offset=40)
    (local.get $outbox)
    (i32.const 1134559232)
    (i32.store offset=44)
    (local.get $outbox)
    (i32.const 1126170624)
    (i32.store offset=48)
    (local.get $outbox)
    (i32.const 1090519040)
    (i32.store offset=52)
    (local.get $outbox)
    (i32.const 1036831949)
    (i32.store offset=56)
    (local.get $outbox)
    (i32.const 1045220557)
    (i32.store offset=60)
    (local.get $outbox)
    (i32.const 1053609165)
    (i32.store offset=64)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=68)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=72)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=76)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=80)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=84)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=88)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=92)

    ;; hit record at outbox + 96: kind, id, x, y, w, h.
    (local.get $outbox)
    (i32.const 3)
    (i32.store offset=96)
    (local.get $outbox)
    (local.get $sequence)
    (i32.store offset=100)
    (local.get $outbox)
    (i32.const 1107296256)
    (i32.store offset=104)
    (local.get $outbox)
    (i32.const 1111490560)
    (i32.store offset=108)
    (local.get $outbox)
    (i32.const 1134559232)
    (i32.store offset=112)
    (local.get $outbox)
    (i32.const 1126170624)
    (i32.store offset=116)

    ;; text quad record at outbox + 120: x, y, w, h, u0, v0, u1, v1, atlas, color.
    (local.get $outbox)
    (i32.const 1111490560)
    (i32.store offset=120)
    (local.get $outbox)
    (i32.const 1116733440)
    (i32.store offset=124)
    (local.get $outbox)
    (i32.const 1098907648)
    (i32.store offset=128)
    (local.get $outbox)
    (i32.const 1098907648)
    (i32.store offset=132)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=136)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=140)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=144)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=148)
    (local.get $outbox)
    (i32.const 0)
    (i32.store offset=152)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=156)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=160)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=164)
    (local.get $outbox)
    (i32.const 1065353216)
    (i32.store offset=168)

    (local.get $outbox64)
    (i64.const 172)
    (call $ui_emit))
)
