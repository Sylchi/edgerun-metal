    (i32.const 1024)
    (i32.const 0)
    (i32.store offset=16)

    (i32.const 1024)
    (i32.const 0)
    (i32.store offset=20)

    (i32.const 1024)
    (i32.const 0)
    (i32.store offset=24)

    (i32.const 1024)
    (i32.const 0)
    (i32.store offset=28)

    (i32.const 1024)
    (i32.const 1)
    (i32.store offset=32)

    ;; rect record at 1060: x, y, w, h, radius, color, color2, mode, shadow.
    (i32.const 1060)
    (i32.const 1107296256)
    (i32.store offset=0)
    (i32.const 1060)
    (i32.const 1111490560)
    (i32.store offset=4)
    (i32.const 1060)
    (i32.const 1134559232)
    (i32.store offset=8)
    (i32.const 1060)
    (i32.const 1126170624)
    (i32.store offset=12)
    (i32.const 1060)
    (i32.const 1090519040)
    (i32.store offset=16)
    (i32.const 1060)
    (i32.const 1036831949)
    (i32.store offset=20)
    (i32.const 1060)
    (i32.const 1045220557)
    (i32.store offset=24)
    (i32.const 1060)
    (i32.const 1053609165)
    (i32.store offset=28)
    (i32.const 1060)
    (i32.const 1065353216)
    (i32.store offset=32)
    (i32.const 1060)
    (i32.const 0)
    (i32.store offset=36)
    (i32.const 1060)
    (i32.const 0)
    (i32.store offset=40)
    (i32.const 1060)
    (i32.const 0)
    (i32.store offset=44)
    (i32.const 1060)
    (i32.const 0)
    (i32.store offset=48)
    (i32.const 1060)
    (i32.const 0)
    (i32.store offset=52)
    (i32.const 1060)
    (i32.const 0)
    (i32.store offset=56)

    ;; hit record at 1120: kind, id, x, y, w, h.
    (i32.const 1120)
    (i32.const 3)
    (i32.store offset=0)
    (i32.const 1120)
    (i32.const 1)
    (i32.store offset=4)
    (i32.const 1120)
    (i32.const 1107296256)
    (i32.store offset=8)
    (i32.const 1120)
    (i32.const 1111490560)
    (i32.store offset=12)
    (i32.const 1120)
    (i32.const 1134559232)
    (i32.store offset=16)
    (i32.const 1120)
    (i32.const 1126170624)
    (i32.store offset=20)

    ;; text quad record at 1144: x, y, w, h, u0, v0, u1, v1, atlas, color.
    (i32.const 1144)
    (i32.const 1111490560)
    (i32.store offset=0)
    (i32.const 1144)
    (i32.const 1116733440)
    (i32.store offset=4)
    (i32.const 1144)
    (i32.const 1098907648)
    (i32.store offset=8)
    (i32.const 1144)
    (i32.const 1098907648)
    (i32.store offset=12)
    (i32.const 1144)
    (i32.const 0)
    (i32.store offset=16)
    (i32.const 1144)
    (i32.const 0)
    (i32.store offset=20)
    (i32.const 1144)
    (i32.const 1065353216)
    (i32.store offset=24)
    (i32.const 1144)
    (i32.const 1065353216)
    (i32.store offset=28)
    (i32.const 1144)
