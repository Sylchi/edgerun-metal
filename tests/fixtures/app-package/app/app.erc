extern i64 ui_emit(i64, i64) __import("edgerun.ui", "emit");
const i64 APP_OUTBOX = 1024;
const i64 APP_PACKET_BYTES = 172;
const i64 APP_PACKET_BYTES_SLOT = 172;
const i64 UI_ABI_VERSION = 1;
const i64 UI_COMMAND_COUNT = 3;
const i64 UI_RECT_COUNT = 1;
const i64 UI_HIT_COUNT = 1;
const i64 UI_EMPTY_COUNT = 0;
const i64 UI_TEXT_COUNT = 1;
const i64 UI_HIT_KIND_BUTTON = 3;
const i64 UI_HIT_ID = 7;
const i64 UI_TEXT_ATLAS_ID = 2;
const i64 UI_HEADER_ABI = 0;
const i64 UI_HEADER_COMMANDS = 4;
const i64 UI_HEADER_RECTS = 8;
const i64 UI_HEADER_HITS = 12;
const i64 UI_HEADER_DRAG_SOURCES = 16;
const i64 UI_HEADER_DROP_TARGETS = 20;
const i64 UI_HEADER_TRANSITIONS = 24;
const i64 UI_HEADER_ICON_QUADS = 28;
const i64 UI_HEADER_TEXT_QUADS = 32;
const i64 UI_RECT_X = 36;
const i64 UI_RECT_Y = 40;
const i64 UI_RECT_W = 44;
const i64 UI_RECT_H = 48;
const i64 UI_RECT_RADIUS = 52;
const i64 UI_RECT_COLOR_R = 56;
const i64 UI_RECT_COLOR_G = 60;
const i64 UI_RECT_COLOR_B = 64;
const i64 UI_RECT_COLOR_A = 68;
const i64 UI_RECT_COLOR2_R = 72;
const i64 UI_RECT_COLOR2_G = 76;
const i64 UI_RECT_COLOR2_B = 80;
const i64 UI_RECT_COLOR2_A = 84;
const i64 UI_RECT_MODE = 88;
const i64 UI_RECT_SHADOW = 92;
const i64 UI_HIT_KIND = 96;
const i64 UI_HIT_RECORD_ID = 100;
const i64 UI_HIT_X = 104;
const i64 UI_HIT_Y = 108;
const i64 UI_HIT_W = 112;
const i64 UI_HIT_H = 116;
const i64 UI_TEXT_X = 120;
const i64 UI_TEXT_Y = 124;
const i64 UI_TEXT_W = 128;
const i64 UI_TEXT_H = 132;
const i64 UI_TEXT_U0 = 136;
const i64 UI_TEXT_V0 = 140;
const i64 UI_TEXT_U1 = 144;
const i64 UI_TEXT_V1 = 148;
const i64 UI_TEXT_ATLAS = 152;
const i64 UI_TEXT_COLOR_R = 156;
const i64 UI_TEXT_COLOR_G = 160;
const i64 UI_TEXT_COLOR_B = 164;
const i64 UI_TEXT_COLOR_A = 168;
const i64 F32_RECT_X = 0x41200000;
const i64 F32_RECT_Y = 0x41a00000;
const i64 F32_RECT_W = 0x42f00000;
const i64 F32_RECT_H = 0x42480000;
const i64 F32_RECT_RADIUS = 0x41000000;
const i64 F32_PANEL_R = 0x3e800000;
const i64 F32_PANEL_G = 0x3f000000;
const i64 F32_PANEL_B = 0x3f400000;
const i64 F32_ONE = 0x3f800000;
const i64 F32_TEXT_X = 0x41300000;
const i64 F32_TEXT_Y = 0x41b00000;
const i64 F32_TEXT_SIZE = 0x41800000;
const i64 UI_RECT_MODE_FILL = 0;
memory(1);
export i64 main(void) {
  i64 ptr = APP_OUTBOX;
  i64 len = 0;
  store32(ptr, APP_PACKET_BYTES_SLOT, APP_PACKET_BYTES);
  len = load32(ptr, APP_PACKET_BYTES_SLOT);
  store16(ptr, UI_HEADER_ABI, UI_ABI_VERSION);
  store32(ptr, UI_HEADER_COMMANDS, UI_COMMAND_COUNT);
  store32(ptr, UI_HEADER_RECTS, UI_RECT_COUNT);
  store32(ptr, UI_HEADER_HITS, UI_HIT_COUNT);
  store32(ptr, UI_HEADER_DRAG_SOURCES, UI_EMPTY_COUNT);
  store32(ptr, UI_HEADER_DROP_TARGETS, UI_EMPTY_COUNT);
  store32(ptr, UI_HEADER_TRANSITIONS, UI_EMPTY_COUNT);
  store32(ptr, UI_HEADER_ICON_QUADS, UI_EMPTY_COUNT);
  store32(ptr, UI_HEADER_TEXT_QUADS, UI_TEXT_COUNT);
  store32(ptr, UI_RECT_X, F32_RECT_X);
  store32(ptr, UI_RECT_Y, F32_RECT_Y);
  store32(ptr, UI_RECT_W, F32_RECT_W);
  store32(ptr, UI_RECT_H, F32_RECT_H);
  store32(ptr, UI_RECT_RADIUS, F32_RECT_RADIUS);
  store32(ptr, UI_RECT_COLOR_R, F32_PANEL_R);
  store32(ptr, UI_RECT_COLOR_G, F32_PANEL_G);
  store32(ptr, UI_RECT_COLOR_B, F32_PANEL_B);
  store32(ptr, UI_RECT_COLOR_A, F32_ONE);
  store32(ptr, UI_RECT_COLOR2_R, F32_PANEL_R);
  store32(ptr, UI_RECT_COLOR2_G, F32_PANEL_G);
  store32(ptr, UI_RECT_COLOR2_B, F32_PANEL_B);
  store32(ptr, UI_RECT_COLOR2_A, F32_ONE);
  store32(ptr, UI_RECT_MODE, UI_RECT_MODE_FILL);
  store32(ptr, UI_RECT_SHADOW, UI_EMPTY_COUNT);
  store32(ptr, UI_HIT_KIND, UI_HIT_KIND_BUTTON);
  store32(ptr, UI_HIT_RECORD_ID, UI_HIT_ID);
  store32(ptr, UI_HIT_X, F32_RECT_X);
  store32(ptr, UI_HIT_Y, F32_RECT_Y);
  store32(ptr, UI_HIT_W, F32_RECT_W);
  store32(ptr, UI_HIT_H, F32_RECT_H);
  store32(ptr, UI_TEXT_X, F32_TEXT_X);
  store32(ptr, UI_TEXT_Y, F32_TEXT_Y);
  store32(ptr, UI_TEXT_W, F32_TEXT_SIZE);
  store32(ptr, UI_TEXT_H, F32_TEXT_SIZE);
  store32(ptr, UI_TEXT_U0, UI_EMPTY_COUNT);
  store32(ptr, UI_TEXT_V0, UI_EMPTY_COUNT);
  store32(ptr, UI_TEXT_U1, F32_ONE);
  store32(ptr, UI_TEXT_V1, F32_ONE);
  store32(ptr, UI_TEXT_ATLAS, UI_TEXT_ATLAS_ID);
  store32(ptr, UI_TEXT_COLOR_R, F32_ONE);
  store32(ptr, UI_TEXT_COLOR_G, F32_ONE);
  store32(ptr, UI_TEXT_COLOR_B, F32_ONE);
  store32(ptr, UI_TEXT_COLOR_A, F32_ONE);
  return ui_emit(ptr, len);
}
