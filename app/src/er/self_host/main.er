const helper: module = @import("src/er/self_host/helper.er");
const buffer_len: usize = 16 * 1024 * 1024;
const source_workspace: [buffer_len]u8 = undefined;
pub export fn er_app_main() i32 { return 7; }
export fn er_self_host_score(seed: i32) i32 { return seed + 5; }
export fn er_self_host_capacity_echo() usize { return source_workspace.len; }
export fn er_ui_source_workspace_ptr() usize { return @intFromPtr(&source_workspace); }
export fn er_ui_source_workspace_capacity() usize { return source_workspace.len; }
