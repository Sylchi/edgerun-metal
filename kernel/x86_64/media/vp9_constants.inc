; EdgeRun VP9 bitstream constants.

%ifndef ER_VP9_CONSTANTS_INC
%define ER_VP9_CONSTANTS_INC

%include "x86_64/media/vp8_constants.inc"

VP9_FRAME_MARKER                    equ 2
VP9_FRAME_MARKER_MASK               equ 0x03
VP9_PROFILE_LOW_MASK                equ 0x04
VP9_PROFILE_LOW_SHIFT               equ 2
VP9_PROFILE_HIGH_MASK               equ 0x08
VP9_PROFILE_HIGH_SHIFT              equ 3
VP9_PROFILE_RESERVED_MASK           equ 0x10
VP9_SHOW_EXISTING_MASK              equ 0x10
VP9_SHOW_EXISTING_SHIFT             equ 4
VP9_SHOW_EXISTING_FRAME_INDEX_MASK  equ 0xe0
VP9_SHOW_EXISTING_FRAME_INDEX_SHIFT equ 5
VP9_FRAME_TYPE_MASK                 equ 0x20
VP9_FRAME_TYPE_SHIFT                equ 5
VP9_SHOW_FRAME_MASK                 equ 0x40
VP9_SHOW_FRAME_SHIFT                equ 6
VP9_ERROR_RESILIENT_MASK            equ 0x80
VP9_ERROR_RESILIENT_SHIFT           equ 7

VP9_FRAME_TYPE_KEY                  equ 0
VP9_FRAME_TYPE_INTER                equ 1
VP9_PROFILE_MAX                     equ 3
VP9_SHOW_EXISTING_HEADER_SIZE       equ 1
VP9_INTER_HEADER_SIZE               equ 1
VP9_KEY_HEADER_SIZE                 equ 9
VP9_KEY_HEADER_RENDER_SIZE          equ 13
VP9_SYNC_CODE_OFFSET                equ 1
VP9_SYNC_CODE_0                     equ 0x49
VP9_SYNC_CODE_1                     equ 0x83
VP9_SYNC_CODE_2                     equ 0x42
VP9_KEY_COLOR_BYTE                  equ 4
VP9_KEY_WIDTH_MID_BYTE              equ 5
VP9_KEY_WIDTH_HIGH_HEIGHT_LOW_BYTE  equ 6
VP9_KEY_HEIGHT_MID_BYTE             equ 7
VP9_KEY_HEIGHT_HIGH_RENDER_FLAG_BYTE equ 8
VP9_KEY_RENDER_WIDTH_MID_BYTE       equ 9
VP9_KEY_RENDER_WIDTH_HIGH_HEIGHT_LOW_BYTE equ 10
VP9_KEY_RENDER_HEIGHT_MID_BYTE      equ 11
VP9_KEY_RENDER_HEIGHT_HIGH_BYTE     equ 12
VP9_KEY_COLOR_SPACE_MASK            equ 0x07
VP9_KEY_RENDER_DIFF_MASK            equ 0x10
VP9_KEY_LOW_NIBBLE_MASK             equ 0x0f
VP9_KEY_LOW_FIVE_MASK               equ 0x1f
VP9_KEY_FIELD_LOW_SHIFT             equ 4
VP9_KEY_FIELD_HIGH_SHIFT            equ 12
VP9_KEY_RENDER_FIELD_LOW_SHIFT      equ 5
VP9_KEY_RENDER_FIELD_MID_SHIFT      equ 3
VP9_KEY_RENDER_FIELD_HIGH_SHIFT     equ 11

VP9_SUPERFRAME_MARKER_MASK          equ 0xe0
VP9_SUPERFRAME_MARKER_VALUE         equ 0xc0
VP9_SUPERFRAME_FRAME_COUNT_MASK     equ 0x07
VP9_SUPERFRAME_SIZE_BYTES_MASK      equ 0x18
VP9_SUPERFRAME_SIZE_BYTES_SHIFT     equ 3
VP9_SUPERFRAME_MIN_INDEX_SIZE       equ 2
VP9_SUPERFRAME_MAX_FRAMES           equ 8
VP9_SUPERFRAME_MAX_SIZE_BYTES       equ 4
VP9_SUPERFRAME_SIZE_BYTES_1         equ 1
VP9_SUPERFRAME_SIZE_BYTES_2         equ 2
VP9_SUPERFRAME_SIZE_BYTES_3         equ 3
VP9_SUPERFRAME_DESC_FRAME_COUNT     equ 0
VP9_SUPERFRAME_DESC_SIZE_BYTES      equ 1
VP9_SUPERFRAME_DESC_INDEX_OFFSET    equ 4
VP9_SUPERFRAME_DESC_PAYLOAD_END     equ 8
VP9_SUPERFRAME_DESC_FRAME_SIZES     equ 12
VP9_SUPERFRAME_DESC_SIZE            equ VP9_SUPERFRAME_DESC_FRAME_SIZES + VP9_SUPERFRAME_MAX_FRAMES * 4
VP9_VALIDATE_STACK_HEADER           equ 0
VP9_VALIDATE_STACK_SUPER            equ VP9_VALIDATE_STACK_HEADER + VP9_HEADER_DESC_SIZE
VP9_VALIDATE_STACK_SIZE             equ 64

VP9_U32_MAX                         equ 0xffffffff
VP9_IVF_HEADER_SIZE                 equ 32
VP9_IVF_FRAME_HEADER_SIZE           equ 12
VP9_IVF_SIGNATURE                   equ 0x46494b44 ; "DKIF" little-endian
VP9_IVF_CODEC_VP90                  equ 0x30395056 ; "VP90" little-endian
VP9_IVF_FILE_VERSION                equ 4
VP9_IVF_FILE_HEADER_LEN             equ 6
VP9_IVF_FILE_CODEC                  equ 8
VP9_IVF_FILE_WIDTH                  equ 12
VP9_IVF_FILE_HEIGHT                 equ 14
VP9_IVF_FILE_TIMEBASE_DEN           equ 16
VP9_IVF_FILE_TIMEBASE_NUM           equ 20
VP9_IVF_FILE_FRAME_COUNT            equ 24
VP9_IVF_FILE_RESERVED               equ 28
VP9_IVF_FRAME_RECORD_LEN            equ 0
VP9_IVF_FRAME_RECORD_TIMESTAMP      equ 4
VP9_IVF_HDR_CODEC                   equ 0
VP9_IVF_HDR_WIDTH                   equ 4
VP9_IVF_HDR_HEIGHT                  equ 6
VP9_IVF_HDR_TIMEBASE_DEN            equ 8
VP9_IVF_HDR_TIMEBASE_NUM            equ 12
VP9_IVF_HDR_FRAME_COUNT             equ 16
VP9_IVF_HDR_SIZE                    equ 24
VP9_IVF_FRAME_PAYLOAD_OFFSET        equ 0
VP9_IVF_FRAME_PAYLOAD_LEN           equ 4
VP9_IVF_FRAME_TIMESTAMP             equ 8
VP9_IVF_FRAME_SIZE                  equ 16
VP9_IVF_SCAN_HDR                    equ 0
VP9_IVF_SCAN_FRAME                  equ VP9_IVF_HDR_SIZE
VP9_IVF_SCAN_PREV_TIMESTAMP         equ VP9_IVF_SCAN_FRAME + VP9_IVF_FRAME_SIZE
VP9_IVF_SCAN_STACK_SIZE             equ 48

VP9_HEADER_DESC_MARKER              equ 0
VP9_HEADER_DESC_PROFILE             equ 1
VP9_HEADER_DESC_SHOW_EXISTING       equ 2
VP9_HEADER_DESC_EXISTING_FRAME_IDX  equ 3
VP9_HEADER_DESC_FRAME_TYPE          equ 4
VP9_HEADER_DESC_SHOW_FRAME          equ 5
VP9_HEADER_DESC_ERROR_RESILIENT     equ 6
VP9_HEADER_DESC_WIDTH               equ 8
VP9_HEADER_DESC_HEIGHT              equ 10
VP9_HEADER_DESC_RENDER_WIDTH        equ 12
VP9_HEADER_DESC_RENDER_HEIGHT       equ 14
VP9_HEADER_DESC_SIZE                equ 16

VP9_BOOL_INITIAL_BYTES              equ VP8_BOOL_INITIAL_BYTES
VP9_BOOL_READER_INPUT_INDEX         equ VP8_BOOL_READER_INPUT_INDEX
VP9_BOOL_READER_SIZE                equ VP8_BOOL_READER_SIZE

VP9_TX_MODE_ONLY_4X4                equ 0
VP9_TX_MODE_ALLOW_8X8               equ 1
VP9_TX_MODE_ALLOW_16X16             equ 2
VP9_TX_MODE_ALLOW_32X32             equ 3
VP9_TX_MODE_SELECT                  equ 4
VP9_TX_MODE_LITERAL_BITS            equ 2
VP9_TX_SIZE_CONTEXTS                equ 2
VP9_TX_8X8_PROB_COUNT               equ 1
VP9_TX_16X16_PROB_COUNT             equ 2
VP9_TX_32X32_PROB_COUNT             equ 3
VP9_TX_PROB_UPDATE_BITS             equ 7
VP9_TX_PROB_UPDATE_TOTAL            equ VP9_TX_SIZE_CONTEXTS * (VP9_TX_8X8_PROB_COUNT + VP9_TX_16X16_PROB_COUNT + VP9_TX_32X32_PROB_COUNT)
VP9_TX_SIZE_4X4                     equ 0
VP9_TX_SIZE_8X8                     equ 1
VP9_TX_SIZE_16X16                   equ 2
VP9_TX_SIZE_32X32                   equ 3
VP9_COEF_PLANE_TYPES                equ 2
VP9_COEF_REF_TYPES                  equ 2
VP9_COEF_BANDS                      equ 6
VP9_COEF_CONTEXTS_BAND0             equ 3
VP9_COEF_CONTEXTS_FULL              equ 6
VP9_COEF_NODES                      equ 3
VP9_COEF_CONTEXTS_TOTAL_PER_TX      equ VP9_COEF_PLANE_TYPES * VP9_COEF_REF_TYPES * (VP9_COEF_CONTEXTS_BAND0 + (VP9_COEF_BANDS - 1) * VP9_COEF_CONTEXTS_FULL) * VP9_COEF_NODES
VP9_COEF_UPDATE_TOTAL               equ (VP9_TX_SIZE_32X32 + 1) * VP9_COEF_CONTEXTS_TOTAL_PER_TX
VP9_DIFF_UPDATE_PROB                equ 252
VP9_PROBABILITY_MAX                 equ 255
VP9_INV_MAP_FAST_COUNT              equ 20
VP9_INV_MAP_FAST_STEP               equ 13
VP9_INV_MAP_FAST_FIRST              equ 7
VP9_INV_MAP_LAST_INDEX              equ 254
VP9_INV_MAP_LAST_VALUE              equ 253
VP9_SKIP_CONTEXTS                   equ 3
VP9_COMPRESSED_HEADER_READER        equ 0
VP9_COMPRESSED_HEADER_TX_MODE       equ VP9_COMPRESSED_HEADER_READER + VP9_BOOL_READER_SIZE
VP9_COMPRESSED_HEADER_TX_UPDATE_COUNT equ VP9_COMPRESSED_HEADER_TX_MODE + 4
VP9_COMPRESSED_HEADER_TX_UPDATES    equ VP9_COMPRESSED_HEADER_TX_UPDATE_COUNT + 4
VP9_COMPRESSED_HEADER_COEF_UPDATE_FLAG equ VP9_COMPRESSED_HEADER_TX_UPDATES + VP9_TX_PROB_UPDATE_TOTAL
VP9_COMPRESSED_HEADER_COEF_UPDATE_COUNT equ VP9_COMPRESSED_HEADER_COEF_UPDATE_FLAG + 4
VP9_COMPRESSED_HEADER_SKIP_UPDATE_COUNT equ VP9_COMPRESSED_HEADER_COEF_UPDATE_COUNT + 4
VP9_COMPRESSED_HEADER_SKIP_UPDATES  equ VP9_COMPRESSED_HEADER_SKIP_UPDATE_COUNT + 4
VP9_COMPRESSED_HEADER_SIZE          equ VP9_COMPRESSED_HEADER_SKIP_UPDATES + VP9_SKIP_CONTEXTS

%endif
