; EdgeRun TLS constants — host-side ASM.
; TLS is a transport encryption layer only. EdgeRun object receipts carry
; authority, identity, and replay proof.

TLS_RECORD_HANDSHAKE            equ 22
TLS_RECORD_APPLICATION_DATA     equ 23
TLS_RECORD_CHANGE_CIPHER_SPEC   equ 20
TLS_RECORD_VERSION_MAJOR        equ 3
TLS_RECORD_VERSION_COMPAT_MINOR equ 1
TLS_LEGACY_VERSION_MINOR        equ 3

TLS_HANDSHAKE_CLIENT_HELLO      equ 1
TLS_HANDSHAKE_SERVER_HELLO      equ 2
TLS_HANDSHAKE_ENCRYPTED_EXTENSIONS equ 8
TLS_HANDSHAKE_CERTIFICATE       equ 11
TLS_HANDSHAKE_CERTIFICATE_VERIFY equ 15
TLS_HANDSHAKE_FINISHED          equ 20

TLS_VERSION_1_3                 equ 0x0304
TLS_CIPHER_AES_128_GCM_SHA256   equ 0x1301
TLS_GROUP_X25519                equ 0x001D

TLS_EXT_SUPPORTED_GROUPS        equ 10
TLS_EXT_SIGNATURE_ALGORITHMS    equ 13
TLS_EXT_SUPPORTED_VERSIONS      equ 43
TLS_EXT_KEY_SHARE               equ 51

TLS_SIG_ECDSA_SECP256R1_SHA256  equ 0x0403
TLS_SIG_ED25519                 equ 0x0807
TLS_SIG_RSA_PSS_RSAE_SHA256     equ 0x0804

TLS_RECORD_HEADER_LEN           equ 5
TLS_RECORD_AAD_LEN              equ 5
TLS_INNER_CONTENT_TYPE_LEN      equ 1
TLS_RECORD_OVERHEAD             equ TLS_RECORD_HEADER_LEN + TLS_INNER_CONTENT_TYPE_LEN + TLS_GCM_TAG_LEN
TLS_HANDSHAKE_HEADER_LEN        equ 4
TLS_RANDOM_LEN                  equ 32
TLS_SESSION_ID_LEN              equ 32
TLS_X25519_KEY_LEN              equ 32
TLS_AES_128_KEY_LEN             equ 16

TLS_EXT_SUPPORTED_VERSIONS_LEN  equ 7
TLS_EXT_SUPPORTED_GROUPS_LEN    equ 8
TLS_EXT_SIGNATURE_ALGORITHMS_LEN equ 12
TLS_EXT_KEY_SHARE_LEN           equ 42
TLS_CLIENT_EXTENSIONS_LEN       equ 69
TLS_CLIENT_HELLO_BODY_LEN       equ 144
TLS_CLIENT_HELLO_PAYLOAD_LEN    equ TLS_HANDSHAKE_HEADER_LEN + TLS_CLIENT_HELLO_BODY_LEN
TLS_CLIENT_HELLO_RECORD_LEN     equ TLS_RECORD_HEADER_LEN + TLS_CLIENT_HELLO_PAYLOAD_LEN
TLS_RX_RECORD_MAX               equ 2048
TLS_TRANSCRIPT_MAX              equ 4096
TLS_PLAINTEXT_MAX               equ TLS_RX_RECORD_MAX - TLS_RECORD_OVERHEAD
TLS_GCM_TAG_LEN                 equ 16
TLS_GCM_IV_LEN                  equ 12
TLS_GCM_BLOCK_LEN               equ 16
TLS_HKDF_LABEL_PREFIX_LEN       equ 6
TLS_HKDF_LABEL_MAX_LEN          equ 32
TLS_HKDF_CONTEXT_MAX_LEN        equ 32
TLS_HKDF_INFO_MAX_LEN           equ 80

TLS_STATE_CLOSED                equ 0
TLS_STATE_CLIENT_HELLO_SENT     equ 1
TLS_STATE_ACTIVE                equ 2

ERROR_TLS_HANDSHAKE             equ 90
ERROR_TLS_RECORD                equ 91
ERROR_TLS_UNSUPPORTED           equ 92
ERROR_TLS_CLOSED                equ 93
